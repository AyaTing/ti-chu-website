---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="聯絡我們 | Ti Chu Interior Design">
  <div class="min-h-screen bg-linear-to-b from-white to-gray-50">
    <div class="max-w-4xl mx-auto px-4 py-24">
      <!-- 標題 -->
      <div class="text-center mb-16">
        <h1 class="text-5xl font-bold mb-4">聯絡我們</h1>
        <p class="text-xl text-gray-600">歡迎與我們討論您的空間設計需求</p>
      </div>
      
      <!-- 聯絡方式 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        <!-- Email -->
        <div class="bg-white p-8 rounded-lg shadow-sm">
          <div class="flex items-start gap-4">
            <svg class="w-6 h-6 text-gray-400 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <div>
              <h3 class="font-semibold mb-2">Email</h3>
              <a href="mailto:info@tichu-design.com" class="text-gray-600 hover:text-gray-900 transition-colors">
                info@tichu-design.com
              </a>
            </div>
          </div>
        </div>
        
        <!-- Phone -->
        <div class="bg-white p-8 rounded-lg shadow-sm">
          <div class="flex items-start gap-4">
            <svg class="w-6 h-6 text-gray-400 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <div>
              <h3 class="font-semibold mb-2">電話</h3>
              <a href="tel:+886-2-xxxx-xxxx" class="text-gray-600 hover:text-gray-900 transition-colors">
                (02) xxxx-xxxx
              </a>
            </div>
          </div>
        </div>
      </div>
      
      <!-- 營業時間 -->
      <div class="bg-white p-8 rounded-lg shadow-sm mb-16">
        <h3 class="font-semibold mb-4">營業時間</h3>
        <div class="space-y-2 text-gray-600">
          <p>週一至週五：10:00 - 18:00</p>
          <p>週六：預約制</p>
          <p>週日及國定假日：公休</p>
        </div>
      </div>
      
      <!-- 說明文字 -->
      <div class="text-center text-gray-600">
        <p class="mb-4">歡迎透過 Email 或電話與我們聯繫</p>
        <p class="text-sm">我們會在 1-2 個工作天內回覆您的訊息</p>
      </div>
    </div>
  </div>
</Layout>