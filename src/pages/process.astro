---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';

const steps = [
  {
    number: '01',
    title: '初步接洽',
    description: '討論需求、風格、預算。',
  },
  {
    number: '02',
    title: '現場丈量',
    description: '現場實際丈量。',
  },
  {
    number: '03',
    title: '設計提案',
    description: '依據需求風格及現場狀況配置平面及空間氛圍。',
  },
  {
    number: '04',
    title: '設計委任',
    description: '簽訂設計合約。',
  },
  {
    number: '05',
    title: '圖面溝通',
    description: '依據平面圖的規劃，討論及細部修改。',
  },
  {
    number: '06',
    title: '工程報價',
    description: '依據圖面及選用材料規劃工程報價。',
  },
  {
    number: '07',
    title: '簽訂工程合約',
    description: '依據設計圖面與工程預算簽訂工程合約。',
  },
  {
    number: '08',
    title: '施工階段',
    description: '依據工程進度安排工班進退場。',
  },
  {
    number: '09',
    title: '完工交屋',
    description: '施工完工業主完成驗收交屋。',
  },
];
---

<Layout title="委託流程 | Ti Chu Interior Design">
  <div class="min-h-screen bg-linear-to-b from-white to-gray-50">
    <div class="max-w-5xl mx-auto px-4 py-24">
      <!-- 標題 -->
      <div class="text-center mb-16">
        <h1 class="text-5xl font-bold mb-4">委託流程</h1>
        <p class="text-xl text-gray-600">從初步洽談到完工交屋，我們陪您走過每一步</p>
      </div>
      
      <!-- 流程步驟 -->
      <div class="space-y-8 mb-4">
        {steps.map((step, index) => (
          <div class="relative flex gap-8 items-start group">
            <!-- 編號 -->
            <div class="shrink-0 w-24 h-24 flex items-center justify-center">
              <span class="text-5xl font-bold text-gray-200 group-hover:text-gray-300 transition-colors">
                {step.number}
              </span>
            </div>
            
            <!-- 內容 -->
            <div class="flex-1 bg-white p-8 rounded-lg shadow-sm hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between mb-4">
                <h2 class="text-2xl font-bold">{step.title}</h2>
                {/* <span class="text-sm text-gray-500 whitespace-nowrap ml-4">{step.duration}</span> */}
              </div>
              <p class="text-gray-600 leading-relaxed">{step.description}</p>
            </div>
            
            {/* 連接線 */}
            {index < steps.length - 1 && (
              <div class="absolute left-12 mt-24 w-0.5 h-8 bg-gray-200"></div>
            )}
          </div>
        ))}
      </div>
      
      <div class="mt-16 text-center">
        <a 
          href="/contact"
          class="inline-block px-8 py-4 bg-black text-white rounded-full hover:bg-gray-800 transition-colors"
        >
          聯絡我們
        </a>
      </div>
    </div>
  </div>
</Layout>