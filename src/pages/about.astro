---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="關於帝筑 | Ti Chu Interior Design">
  <div class="min-h-screen bg-linear-to-b from-white to-gray-50">
    <div class="max-w-4xl mx-auto px-4 py-24">
      <!-- 標題 -->
      <h1 class="text-5xl font-bold mb-8">關於帝筑</h1>
      
      <!-- 簡介 -->
      <div class="prose lg:prose-xl mb-16">
        <p class="text-xl text-gray-600 leading-relaxed">
          帝筑設計致力於創造兼具美學與機能的空間，我們相信好的設計源自於對生活的細膩觀察與深刻理解。
        </p>
      </div>
      
      <!-- 設計理念 -->
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8">設計理念</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { title: '以人為本', desc: '深入了解使用者需求，打造最適合的生活空間' },
            { title: '永續設計', desc: '選用環保材料，創造經得起時間考驗的設計' },
            { title: '細節至上', desc: '從規劃到施工，每個環節都精準把關' },
          ].map(item => (
            <div class="p-6 bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow">
              <h3 class="text-xl font-semibold mb-3">{item.title}</h3>
              <p class="text-gray-600">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>
      
      <!-- 服務項目 -->
      <section>
        <h2 class="text-3xl font-bold mb-8">服務項目</h2>
        <ul class="space-y-4">
          {[
            '住宅空間設計',
            '商業空間設計',
            '舊屋翻新改造',
            '軟裝搭配規劃',
            '施工監造管理',
          ].map(item => (
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-gray-400 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              <span class="text-lg">{item}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>