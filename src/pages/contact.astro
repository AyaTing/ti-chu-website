---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/react/ContactForm';
---

<Layout title="聯絡我們 | Ti Chu Interior Design">
  <div class="min-h-screen bg-linear-to-b from-white to-gray-50">
    <div class="max-w-5xl mx-auto px-4 py-24">

      <!-- 標題 -->
      <div class="text-center mb-16">
        <h1 class="text-5xl font-bold mb-4">聯絡我們</h1>
        <p class="text-xl text-gray-600">歡迎與我們討論您的空間設計需求</p>
      </div>

      <!-- 左右兩欄 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">

        <!-- 左：公司資訊 -->
        <div class="space-y-6">
          <!-- 裝飾圖片 -->
          <div class="aspect-4/3 overflow-hidden rounded-lg shadow-sm">
            <img
              src="https://pub-5c6c4c0583ec49659c2c1653ed4d7fa4.r2.dev/1517706953.png"
              alt="帝筑室內設計作品"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="bg-white p-8 rounded-lg shadow-sm space-y-5">
            <div>
              <p class="text-sm text-gray-400 mb-1">公司名稱</p>
              <p class="font-semibold">帝筑室內設計</p>
            </div>
            <div>
              <p class="text-sm text-gray-400 mb-1">公司地址</p>
              <p class="text-gray-600">—</p>
            </div>
            <div>
              <p class="text-sm text-gray-400 mb-1">電話</p>
              <span class="text-gray-600">—</span>
            </div>
            <div>
              <p class="text-sm text-gray-400 mb-1">Line ID</p>
              <p class="text-gray-600">—</p>
            </div>
            <div>
              <p class="text-sm text-gray-400 mb-1">Email</p>
              <span class="text-gray-600">—</span>
            </div>
            <div>
              <p class="text-sm text-gray-400 mb-1">營業時間</p>
              <p class="text-gray-600">—</p>
            </div>
          </div>
        </div>

        <!-- 右：詢問表單 -->
        <div class="bg-white p-8 rounded-lg shadow-sm">
          <ContactForm client:load />
        </div>

      </div>
    </div>
  </div>
</Layout>
