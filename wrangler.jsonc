{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ti-chu-website",
	"compatibility_date": "2026-02-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"pages_build_output_dir": "./dist",
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "ti-chu-media"
		}
	]
}
